# Public frontend configuration; rebuild when these change.
VITE_PRIVY_APP_ID=
VITE_VANTAGE_NETWORK=studionet
# API and persistent worker. Keep private values in a secret manager.
NODE_ENV=development
PORT=3001
VANTAGE_NETWORK=studionet
DATABASE_URL=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
CORS_ORIGINS=http://localhost:5173
V2_DEPLOYMENT_FILE=deployed_v2.json
KEEPER_KEY=
DEPLOYER_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Explicit local experiments only; never honored in production.
LOCAL_DEMO_AUTH=0
